<!DOCTYPE html>
<html lang="ja"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>天気読み上げ</title>
<style>
body{font-family:sans-serif;margin:0;padding:12px;background:#f3f6fa;color:#222}
.row{display:flex;gap:6px;margin-bottom:8px}
input{flex:1;padding:8px;font-size:16px;min-width:0}
button{padding:8px 12px;font-size:15px}
.city{background:#fff;border-radius:10px;padding:10px;margin:10px 0}
.days{display:flex;gap:4px;overflow-x:auto}
.d{min-width:54px;text-align:center;font-size:12px}
.bar{height:60px;display:flex;align-items:flex-end;justify-content:center}
.bar i{display:block;width:22px;background:#4a90e2;border-radius:3px 3px 0 0}
#st{font-size:13px;color:#555}
</style></head><body>
<h3>週間天気(降水)</h3>
<div class="row"><input id="c1" placeholder="地点1 例:東京"><input id="c2" placeholder="地点2 例:大阪"></div>
<div class="row">
<button onclick="load()">表示</button>
<button onclick="speak()">今すぐ読み上げ</button>
<button onclick="arm()">毎朝9時ON</button></div>
<div id="st"></div><div id="out"></div>
<script>
const W=c=>c==0?["快晴","☀️"]:c<=2?["晴れ時々くもり","🌤️"]:c==3?["くもり","☁️"]:c<=48?["霧","🌫️"]:
c<=57?["霧雨","🌦️"]:c<=67?["雨","🌧️"]:c<=77?["雪","❄️"]:c<=82?["にわか雨","🌦️"]:c<=86?["雪","❄️"]:["雷雨","⛈️"];
let data=[];
const $=id=>document.getElementById(id);
$("c1").value=localStorage.c1||"";$("c2").value=localStorage.c2||"";
async function geo(n){
 const r=await(await fetch("https://geocoding-api.open-meteo.com/v1/search?count=1&language=ja&name="+encodeURIComponent(n))).json();
 if(!r.results)throw n+"が見つかりません";return r.results[0];}
async function load(){
 try{
  localStorage.c1=$("c1").value;localStorage.c2=$("c2").value;
  data=[];$("out").innerHTML="";
  for(const id of["c1","c2"]){
   const n=$(id).value.trim();if(!n)continue;
   const g=await geo(n);
   const f=(await(await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${g.latitude}&longitude=${g.longitude}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum&timezone=auto&forecast_days=7`)).json()).daily;
   data.push({name:n,f});
   $("out").innerHTML+=`<div class="city"><b>${g.name}</b><div class="days">`+
    f.time.map((t,i)=>{const w=W(f.weather_code[i]),p=f.precipitation_probability_max[i]||0;
    return `<div class="d">${t.slice(5).replace("-","/")}<br>${w[1]}<div class="bar"><i style="height:${p*0.6}px"></i></div>${p}%<br>${Math.round(f.temperature_2m_max[i])}/${Math.round(f.temperature_2m_min[i])}°</div>`}).join("")+`</div></div>`;
  }
 }catch(e){$("st").textContent="エラー: "+e}
}
function text(){
 return data.map(({name,f})=>{
  const w=W(f.weather_code[0])[0],p=f.precipitation_probability_max[0];
  const rain=f.time.map((t,i)=>f.precipitation_probability_max[i]>=60?i:-1).filter(i=>i>0);
  return `${name}の今日は${w}、最高${Math.round(f.temperature_2m_max[0])}度、最低${Math.round(f.temperature_2m_min[0])}度、降水確率${p}パーセント。`+
  (rain.length?`今週は${rain.map(i=>f.time[i].slice(5).replace("-","月")+"日").join("、")}に雨の可能性が高いです。`:"今週は大きな雨の予報はありません。");
 }).join("");
}
async function speak(){
 if(!data.length)await load();
 speechSynthesis.cancel();
 const u=new SpeechSynthesisUtterance("おはようございます。"+text());
 u.lang="ja-JP";speechSynthesis.speak(u);
}
let armed=false,last="";
async function arm(){
 if(armed)return;armed=true;
 try{await navigator.wakeLock.request("screen")}catch(e){}
 await load();speechSynthesis.speak(new SpeechSynthesisUtterance(""));
 $("st").textContent="毎朝9時に読み上げます(このページを開いたままにしてください)";
 setInterval(()=>{
  const d=new Date(),k=d.toDateString();
  if(d.getHours()==9&&d.getMinutes()==0&&last!=k){last=k;load().then(speak)}
 },15000);
}
if(data.length==0&&$("c1").value)load();
</script></body></html>